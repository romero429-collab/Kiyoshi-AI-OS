load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "herdr_lib",
    srcs = ["src/lib.rs"],
    crate_name = "herdr",
)

rust_binary(
    name = "herdr",
    srcs = ["src/main.rs"],
    deps = [":herdr_lib"],
)
