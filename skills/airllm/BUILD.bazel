load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "airllm_lib",
    srcs = ["src/lib.rs"],
    crate_name = "airllm",
)

rust_binary(
    name = "airllm",
    srcs = ["src/main.rs"],
    deps = [":airllm_lib"],
)
