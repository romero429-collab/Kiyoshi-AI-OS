load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "moco_lib",
    srcs = ["src/lib.rs"],
    crate_name = "moco",
)

rust_binary(
    name = "moco",
    srcs = ["src/main.rs"],
    deps = [":moco_lib"],
)
