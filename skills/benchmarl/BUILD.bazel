load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "benchmarl_lib",
    srcs = ["src/lib.rs"],
    crate_name = "benchmarl",
)

rust_binary(
    name = "benchmarl",
    srcs = ["src/main.rs"],
    deps = [":benchmarl_lib"],
)
