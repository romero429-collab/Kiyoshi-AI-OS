load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "eupe_lib",
    srcs = ["src/lib.rs"],
    crate_name = "eupe",
)

rust_binary(
    name = "eupe",
    srcs = ["src/main.rs"],
    deps = [":eupe_lib"],
)
