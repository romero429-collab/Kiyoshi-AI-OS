load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ruview_lib",
    srcs = ["src/lib.rs"],
    crate_name = "ruview",
)

rust_binary(
    name = "ruview",
    srcs = ["src/main.rs"],
    deps = [":ruview_lib"],
)
