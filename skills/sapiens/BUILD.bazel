load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "sapiens_lib",
    srcs = ["src/lib.rs"],
    crate_name = "sapiens",
)

rust_binary(
    name = "sapiens",
    srcs = ["src/main.rs"],
    deps = [":sapiens_lib"],
)
