load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "codegen_lib",
    srcs = ["src/lib.rs"],
    crate_name = "codegen",
)

rust_binary(
    name = "codegen",
    srcs = ["src/main.rs"],
    deps = [":codegen_lib"],
)
