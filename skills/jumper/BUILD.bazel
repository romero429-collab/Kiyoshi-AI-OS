load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "jumper_lib",
    srcs = ["src/lib.rs"],
    crate_name = "jumper",
)

rust_binary(
    name = "jumper",
    srcs = ["src/main.rs"],
    deps = [":jumper_lib"],
)
