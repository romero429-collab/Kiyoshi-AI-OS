load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "turso_lib",
    srcs = ["src/lib.rs"],
    crate_name = "turso",
)

rust_binary(
    name = "turso",
    srcs = ["src/main.rs"],
    deps = [":turso_lib"],
)
