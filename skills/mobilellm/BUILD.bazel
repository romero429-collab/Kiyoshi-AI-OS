load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "mobilellm_lib",
    srcs = ["src/lib.rs"],
    crate_name = "mobilellm",
)

rust_binary(
    name = "mobilellm",
    srcs = ["src/main.rs"],
    deps = [":mobilellm_lib"],
)
