load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "strix_lib",
    srcs = ["src/lib.rs"],
    crate_name = "strix",
)

rust_binary(
    name = "strix",
    srcs = ["src/main.rs"],
    deps = [":strix_lib"],
)
