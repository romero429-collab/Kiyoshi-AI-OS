load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "shaper_lib",
    srcs = ["src/lib.rs"],
    crate_name = "shaper",
)

rust_binary(
    name = "shaper",
    srcs = ["src/main.rs"],
    deps = [":shaper_lib"],
)
