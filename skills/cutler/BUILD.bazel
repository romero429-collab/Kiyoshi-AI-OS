load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cutler_lib",
    srcs = ["src/lib.rs"],
    crate_name = "cutler",
)

rust_binary(
    name = "cutler",
    srcs = ["src/main.rs"],
    deps = [":cutler_lib"],
)
