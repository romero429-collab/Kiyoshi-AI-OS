load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "crag_lib",
    srcs = ["src/lib.rs"],
    crate_name = "crag",
)

rust_binary(
    name = "crag",
    srcs = ["src/main.rs"],
    deps = [":crag_lib"],
)
