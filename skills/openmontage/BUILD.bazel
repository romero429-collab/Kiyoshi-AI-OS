load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "openmontage_lib",
    srcs = ["src/lib.rs"],
    crate_name = "openmontage",
)

rust_binary(
    name = "openmontage",
    srcs = ["src/main.rs"],
    deps = [":openmontage_lib"],
)
