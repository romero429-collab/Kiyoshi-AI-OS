load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "orca_lib",
    srcs = ["src/lib.rs"],
    crate_name = "orca",
)

rust_binary(
    name = "orca",
    srcs = ["src/main.rs"],
    deps = [":orca_lib"],
)
