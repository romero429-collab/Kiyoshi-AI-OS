load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "openshell_lib",
    srcs = ["src/lib.rs"],
    crate_name = "openshell",
)

rust_binary(
    name = "openshell",
    srcs = ["src/main.rs"],
    deps = [":openshell_lib"],
)
