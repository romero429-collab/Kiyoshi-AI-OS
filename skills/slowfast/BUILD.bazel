load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "slowfast_lib",
    srcs = ["src/lib.rs"],
    crate_name = "slowfast",
)

rust_binary(
    name = "slowfast",
    srcs = ["src/main.rs"],
    deps = [":slowfast_lib"],
)
