load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "iptv_lib",
    srcs = ["src/lib.rs"],
    crate_name = "iptv",
)

rust_binary(
    name = "iptv",
    srcs = ["src/main.rs"],
    deps = [":iptv_lib"],
)
