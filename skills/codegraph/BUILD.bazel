load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "codegraph_lib",
    srcs = ["src/lib.rs"],
    crate_name = "codegraph",
)

rust_binary(
    name = "codegraph",
    srcs = ["src/main.rs"],
    deps = [":codegraph_lib"],
)
