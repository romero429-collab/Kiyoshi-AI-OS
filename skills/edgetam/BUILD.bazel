load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "edgetam_lib",
    srcs = ["src/lib.rs"],
    crate_name = "edgetam",
)

rust_binary(
    name = "edgetam",
    srcs = ["src/main.rs"],
    deps = [":edgetam_lib"],
)
