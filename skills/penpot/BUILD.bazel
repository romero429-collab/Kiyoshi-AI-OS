load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "penpot_lib",
    srcs = ["src/lib.rs"],
    crate_name = "penpot",
)

rust_binary(
    name = "penpot",
    srcs = ["src/main.rs"],
    deps = [":penpot_lib"],
)
