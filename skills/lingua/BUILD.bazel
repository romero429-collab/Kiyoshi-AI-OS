load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "lingua_lib",
    srcs = ["src/lib.rs"],
    crate_name = "lingua",
)

rust_binary(
    name = "lingua",
    srcs = ["src/main.rs"],
    deps = [":lingua_lib"],
)
