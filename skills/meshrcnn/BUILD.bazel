load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "meshrcnn_lib",
    srcs = ["src/lib.rs"],
    crate_name = "meshrcnn",
)

rust_binary(
    name = "meshrcnn",
    srcs = ["src/main.rs"],
    deps = [":meshrcnn_lib"],
)
