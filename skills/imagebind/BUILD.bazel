load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "imagebind_lib",
    srcs = ["src/lib.rs"],
    crate_name = "imagebind",
)

rust_binary(
    name = "imagebind",
    srcs = ["src/main.rs"],
    deps = [":imagebind_lib"],
)
