load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fairo_lib",
    srcs = ["src/lib.rs"],
    crate_name = "fairo",
)

rust_binary(
    name = "fairo",
    srcs = ["src/main.rs"],
    deps = [":fairo_lib"],
)
