load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "markitdown_lib",
    srcs = ["src/lib.rs"],
    crate_name = "markitdown",
)

rust_binary(
    name = "markitdown",
    srcs = ["src/main.rs"],
    deps = [":markitdown_lib"],
)
