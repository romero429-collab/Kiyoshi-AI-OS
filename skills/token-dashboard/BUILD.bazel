load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "token_dashboard_lib",
    srcs = ["src/lib.rs"],
    crate_name = "token_dashboard",
)

rust_binary(
    name = "token_dashboard",
    srcs = ["src/main.rs"],
    deps = [":token_dashboard_lib"],
)
