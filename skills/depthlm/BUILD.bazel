load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "depthlm_lib",
    srcs = ["src/lib.rs"],
    crate_name = "depthlm",
)

rust_binary(
    name = "depthlm",
    srcs = ["src/main.rs"],
    deps = [":depthlm_lib"],
)
