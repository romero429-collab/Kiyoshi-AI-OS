load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "sonar_lib",
    srcs = ["src/lib.rs"],
    crate_name = "sonar",
)

rust_binary(
    name = "sonar",
    srcs = ["src/main.rs"],
    deps = [":sonar_lib"],
)
