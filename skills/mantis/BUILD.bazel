load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "mantis_lib",
    srcs = ["src/lib.rs"],
    crate_name = "mantis",
)

rust_binary(
    name = "mantis",
    srcs = ["src/main.rs"],
    deps = [":mantis_lib"],
)
